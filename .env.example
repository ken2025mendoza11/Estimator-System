# Browser-safe Supabase settings. Copy to .env and fill in.
# Use the project URL and the publishable / anon key only.
# NEVER put the service-role key here or anywhere in client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Supabase Dashboard → Project Settings → JWT Keys → Legacy JWT Secret.
# Do not prefix this with VITE_. The browser must never receive it.
SUPABASE_JWT_SECRET=
