# Browser-safe Supabase settings. Copy to .env and fill in.
# Use the project URL and the publishable / anon key only.
# NEVER put the service-role key here or anywhere in client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Supabase Dashboard → Project Settings → JWT Keys → Legacy JWT Secret.
# Do not prefix this with VITE_. The browser must never receive it.
SUPABASE_JWT_SECRET=

# Server only. Comma-separated emails and/or @domain entries allowed to open the estimator,
# e.g. ken@example.com,@yourcompany.com. Case-insensitive. Do not prefix with VITE_.
# Empty = every signed-in account is allowed (the server logs a warning).
ESTIMATOR_ALLOWED_EMAILS=

# ── Sign-in (better-auth), all server only — never prefix with VITE_ ──
# Public origin of the app, no trailing slash.
BETTER_AUTH_URL=https://estimator-system.vercel.app
# Long random string, e.g. `openssl rand -hex 32`. Required when deployed.
BETTER_AUTH_SECRET=
# Postgres for users/sessions (a separate Neon / Vercel Postgres database, NOT Supabase).
DATABASE_URL=
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → Web application).
# Authorized redirect URI: https://estimator-system.vercel.app/api/auth/callback/google
# Used only when GROK_AUTH_CLIENT_ID / GROK_AUTH_CLIENT_SECRET are not set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to 1 only if you want `npm run build` to apply migrations/ to DATABASE_URL.
# Default: builds never touch a database; run `npm run db:migrate` instead.
AUTH_MIGRATE_ON_BUILD=
